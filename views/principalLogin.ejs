<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Principal Portal | Login</title>
</head>
<body class="flex items-center justify-center min-h-screen bg-gray-100">
  <div class="w-full max-w-xs mx-4">
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="px-6 py-4 bg-blue-600">
        <h1 class="text-xl font-bold text-white">Principal Portal Login</h1>
        <p class="text-blue-100 text-sm mt-1">Please enter your credentials to access the system</p>
      </div>
      
      <form action="/principal/login" method="POST" class="px-6 py-4">
        <div class="mb-4">
          <label class="block text-gray-700 text-sm font-medium mb-1" for="username">Username</label>
          <input id="username" type="text" name="username" class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500" required>
        </div>
        
        <div class="mb-4">
          <label class="block text-gray-700 text-sm font-medium mb-1" for="password">Password</label>
          <input id="password" type="password" name="password" class="w-full px-3 py-2 text-sm border border-gray-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-500" required>
        </div>
        
        <div class="mb-2">
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded font-medium">
            Sign In
          </button>
        </div>
      </form>
      
      <div class="px-6 py-3 bg-gray-50 border-t border-gray-200 flex justify-between items-center">
        <a href="/" class="text-sm text-gray-600 hover:text-blue-600">← Back to Home</a>
        <span class="text-xs text-gray-500">© 2025 Pydah Institutions</span>
      </div>
    </div>
    
    <div class="mt-4 text-center text-sm text-gray-600">
      Need technical support? <a href="#" class="text-blue-600 hover:underline">Contact IT Department</a>
    </div>
  </div>
</body>
</html>