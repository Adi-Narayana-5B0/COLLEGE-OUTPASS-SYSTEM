<!DOCTYPE html>
<html lang="en">
<head>
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Student Registration</title>
</head>
<body class="flex items-center justify-center h-screen bg-gray-100">
  <form action="/student/register" method="POST" class="bg-white p-6 rounded shadow-md w-96">
    <h2 class="text-2xl font-bold mb-4 text-center">Student Registration</h2>
    
    <label class="block mb-2">Name</label>
    <input type="text" name="name" class="w-full border border-gray-300 p-2 mb-4 rounded" required>

    <label class="block mb-2">Roll Number</label>
    <input type="text" name="rollNumber" class="w-full border border-gray-300 p-2 mb-4 rounded" required>

    <label class="block mb-2">Password</label>
    <input type="password" name="password" class="w-full border border-gray-300 p-2 mb-4 rounded" required>

    <label class="block mb-2">Branch</label>
    <input type="text" name="branch" class="w-full border border-gray-300 p-2 mb-4 rounded" required>

    <label class="block mb-2">Year</label>
    <input type="number" name="year" class="w-full border border-gray-300 p-2 mb-4 rounded" required>

    <button type="submit" class="bg-green-500 text-white w-full py-2 rounded">Register</button>
  </form>
</body>
</html>
