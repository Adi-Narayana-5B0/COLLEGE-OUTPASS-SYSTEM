<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>Student Portal | Login</title>
</head>
<body class="flex items-center justify-center min-h-screen bg-gradient-to-br from-gray-100 to-gray-200 relative">
  
  <% if (typeof error !== 'undefined') { %>
    <div id="errorPopup" class="absolute top-6 bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded shadow-md transition-opacity duration-500" role="alert">
      <strong class="font-bold">Error:</strong>
      <span class="block sm:inline"><%= error %></span>
    </div>
  <% } %>
  
  <div class="w-full max-w-md px-6 py-8">
    <div class="bg-white rounded-lg shadow-xl overflow-hidden">
      <div class="px-8 py-6 bg-blue-600">
        <h2 class="text-xl font-bold text-white">Student Portal Login</h2>
        <p class="text-blue-100 text-sm mt-1">Please enter your credentials to access the system</p>
      </div>
      
      <form action="/student/login" method="POST" class="px-8 py-6">
        <div class="mb-4">
          <label class="block text-gray-700 text-sm font-medium mb-2" for="rollNumber">Roll Number</label>
          <input id="rollNumber" type="text" name="rollNumber" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" required>
        </div>
        
        <div class="mb-6">
          <label class="block text-gray-700 text-sm font-medium mb-2" for="password">Password</label>
          <input id="password" type="password" name="password" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" required>
          <div class="flex justify-end mt-1">
            <a href="#" class="text-xs text-blue-600 hover:text-blue-800">Forgot password?</a>
          </div>
        </div>
        
        <div>
          <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white py-2 px-4 rounded-md font-medium transition duration-200 ease-in-out shadow-md hover:shadow-lg">
            Sign In
          </button>
        </div>
      </form>
      
      <div class="px-8 py-4 bg-gray-50 border-t border-gray-100 flex justify-between items-center">
        <a href="/" class="text-sm text-gray-600 hover:text-blue-600 transition">
          ← Back to Home
        </a>
        <span class="text-xs text-gray-500">© 2025 Pydah Institutions</span>
      </div>
    </div>
    
    <div class="mt-6 text-center text-sm text-gray-600">
      Need technical support? <a href="#" class="text-blue-600 hover:underline">Contact IT Department</a>
    </div>
  </div>

  <script>
    // Auto-hide error popup after 3 seconds
    const popup = document.getElementById('errorPopup');
    if (popup) {
      setTimeout(() => {
        popup.style.opacity = '0';
        setTimeout(() => popup.remove(), 500); // remove after fade out
      }, 3000);
    }
  </script>
</body>
</html>