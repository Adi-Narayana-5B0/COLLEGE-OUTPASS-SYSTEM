<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.1.1/css/all.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/alpinejs/3.10.3/cdn.min.js" defer></script>
  <title>CampusPass - HOD Dashboard</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            primary: {
              50: '#eef2ff',
              100: '#e0e7ff',
              200: '#c7d2fe',
              300: '#a5b4fc',
              400: '#818cf8',
              500: '#6366f1',
              600: '#4f46e5',
              700: '#4338ca',
              800: '#3730a3',
              900: '#312e81',
            },
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          },
        },
      },
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
    
    .dashboard-pattern {
      background-color: #f9fafb;
      background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M11 18c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm48 25c3.866 0 7-3.134 7-7s-3.134-7-7-7-7 3.134-7 7 3.134 7 7 7zm-43-7c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm63 31c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM34 90c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zm56-76c1.657 0 3-1.343 3-3s-1.343-3-3-3-3 1.343-3 3 1.343 3 3 3zM12 86c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm28-65c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm23-11c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm-6 60c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm29 22c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zM32 63c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5zm57-13c2.76 0 5-2.24 5-5s-2.24-5-5-5-5 2.24-5 5 2.24 5 5 5z' fill='%234f46e5' fill-opacity='0.05' fill-rule='evenodd'/%3E%3C/svg%3E");
    }
  </style>
</head>
<body class="font-sans dashboard-pattern min-h-screen">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8">
    <!-- Header -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
      <div class="flex flex-col sm:flex-row justify-between items-center">
        <div class="flex items-center mb-4 sm:mb-0">
          <div class="bg-primary-600 text-white p-3 rounded-lg mr-4">
            <i class="fas fa-user-tie text-xl"></i>
          </div>
          <div>
            <h1 class="text-2xl font-bold text-gray-800">HOD Dashboard</h1>
            <p class="text-gray-500">Review Student Requests</p>
          </div>
        </div>
        <a href="/" class="flex items-center bg-primary-600 hover:bg-primary-700 text-white px-5 py-2.5 rounded-lg transition-all duration-200">
          <i class="fas fa-sign-out-alt mr-2"></i>
          <span>Logout</span>
        </a>
      </div>
    </div>

    <!-- Main Content -->
    <div class="bg-white rounded-lg shadow-md overflow-hidden">
      <div class="p-6 border-b border-gray-200">
        <h2 class="text-lg font-semibold text-gray-800 flex items-center">
          <i class="fas fa-clipboard-list mr-2 text-primary-600"></i>
          Request List
        </h2>
      </div>
      
      <!-- Request Table -->
      <div class="overflow-x-auto">
        <table class="w-full">
          <thead>
            <tr class="bg-gray-50 text-left text-gray-600 text-sm uppercase tracking-wider">
              <th class="py-3 px-4 font-semibold">Name</th>
              <th class="py-3 px-4 font-semibold">Roll Number</th>
              <th class="py-3 px-4 font-semibold">Reason</th>
              <th class="py-3 px-4 font-semibold text-center">Date</th>
              <th class="py-3 px-4 font-semibold text-center">Time</th>
              <th class="py-3 px-4 font-semibold text-center">Status</th>
              <th class="py-3 px-4 font-semibold text-center">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% requests.slice().reverse().forEach(request => { %>
              <tr class="border-t border-gray-100 hover:bg-gray-50">
                <td class="py-3 px-4 text-gray-800"><%= request.name %></td>
                <td class="py-3 px-4 text-gray-800"><%= request.rollNumber %></td>
                <td class="py-3 px-4 text-gray-800"><%= request.reason %></td>
                <td class="py-3 px-4 text-center text-gray-800"><%= request.date %></td>
                <td class="py-3 px-4 text-center text-gray-800"><%= request.time %></td>
                <td class="py-3 px-4 text-center">
                  <% if (request.status === 'Pending') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                      <i class="fas fa-clock mr-1"></i> Pending
                    </span>
                  <% } else if (request.status === 'Forwarded') { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                      <i class="fas fa-paper-plane mr-1"></i> Forwarded
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">
                      <i class="fas fa-times-circle mr-1"></i> Rejected
                    </span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-center">
                  <% if (request.status === 'Pending') { %>
                    <div class="flex flex-col sm:flex-row justify-center gap-2">
                      <form action="/hod/update" method="POST" class="inline-block">
                        <input type="hidden" name="id" value="<%= request._id %>">
                        <button name="status" value="Forwarded" class="bg-primary-500 hover:bg-primary-600 text-white text-sm px-3 py-1.5 rounded-md transition-colors duration-200 flex items-center justify-center w-full sm:w-auto">
                          <i class="fas fa-check mr-1"></i> Forward
                        </button>
                      </form>
                      <form action="/hod/update" method="POST" class="inline-block">
                        <input type="hidden" name="id" value="<%= request._id %>">
                        <button name="status" value="Rejected" class="bg-red-500 hover:bg-red-600 text-white text-sm px-3 py-1.5 rounded-md transition-colors duration-200 flex items-center justify-center w-full sm:w-auto">
                          <i class="fas fa-ban mr-1"></i> Reject
                        </button>
                      </form>
                    </div>
                  <% } else { %>
                    <span class="text-gray-400 italic text-sm">No actions</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      
      <!-- Empty State (Show only if no requests) -->
      <% if (requests.length === 0) { %>
        <div class="py-12 text-center">
          <div class="inline-flex items-center justify-center w-16 h-16 bg-primary-100 rounded-full mb-4">
            <i class="fas fa-clipboard-list text-primary-600 text-2xl"></i>
          </div>
          <h3 class="text-lg font-medium text-gray-900">No requests yet</h3>
          <p class="mt-2 text-gray-500">When students submit requests, they will appear here for your review.</p>
        </div>
      <% } %>
    </div>
    
    <!-- Footer -->
    <div class="mt-6 text-center text-gray-500 text-sm">
      <p>© 2025 CampusPass. All rights reserved.</p>
    </div>
  </div>
</body>
</html>